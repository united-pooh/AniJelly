@@ -0,0 +1,63 @@
+import { ImageType } from '@jellyfin/sdk/lib/generated-client/models/image-type';
+import { describe, expect, it, vi } from 'vitest';
+
+import { createApiClient } from './createApiClient';
+
+const makeClient = () => createApiClient('http://localhost:8096/base', 'Web', '13', 'Browser', 'device');
+
+describe('current server user routes', () => {
+    it.each([
+        ['Items', 'Items'],
+        ['Items/Resume', 'UserItems/Resume'],
+        ['Items/Latest', 'Items/Latest'],
+        ['Items/Root', 'Items/Root'],
+        ['Items/item', 'Items/item'],
+        ['Items/item/Intros', 'Items/item/Intros'],
+        ['Items/item/LocalTrailers', 'Items/item/LocalTrailers'],
+        ['Items/item/SpecialFeatures', 'Items/item/SpecialFeatures'],
+        ['Items/item/UserData', 'UserItems/item/UserData'],
+        ['Items/item/Rating', 'UserItems/item/Rating'],
+        ['PlayedItems/item', 'UserPlayedItems/item'],
+        ['FavoriteItems/item', 'UserFavoriteItems/item'],
+        ['Views', 'UserViews'],
+        ['GroupingOptions', 'UserViews/GroupingOptions'],
+        ['Suggestions', 'Items/Suggestions'],
+        ['Password', 'Users/Password'],
+        ['Configuration', 'Users/Configuration']
+    ])('moves Users/user/%s to %s and preserves query parameters', (oldPath, newPath) => {
+        const options = { Limit: 12 };
+        const url = new URL(makeClient().getUrl(`Users/user/${oldPath}`, options));
+        expect(url.pathname).toBe(`/base/${newPath}`);
+        expect(url.searchParams.get('userId')).toBe('user');
+        expect(url.searchParams.get('Limit')).toBe('12');
+        expect(options).toEqual({ Limit: 12 });
+    });
+
+    it.each(['Users/user', 'Users/user/Policy', 'Users/AuthenticateByName', 'Artists/item/InstantMix', 'Items/item/Images/Primary'])('preserves the active route %s', path => {
+        expect(makeClient().getUrl(path)).toBe(`http://localhost:8096/base/${path}`);
+    });
+
+    it('preserves GET and DELETE user while moving only updateUser to POST Users', async () => {
+        const client = makeClient();
+        const request = vi.spyOn(client, 'ajax').mockResolvedValue(undefined);
+        const user = { Id: 'user', Name: 'Administrator' };
+        await client.updateUser(user);
+        expect(request).toHaveBeenCalledWith(expect.objectContaining({
+            type: 'POST', url: 'http://localhost:8096/base/Users?userId=user', data: JSON.stringify(user)
+        }));
+        await client.deleteUser('user');
+        expect(request).toHaveBeenLastCalledWith({ type: 'DELETE', url: 'http://localhost:8096/base/Users/user' });
+    });
+
+    it('uses the same current route for display and indexed deletion of a user avatar', async () => {
+        const client = makeClient();
+        const url = new URL(client.getUserImageUrl('user', { type: ImageType.Primary, index: 0, tag: 'cache', format: 'png', width: 80 }));
+        expect(url.pathname).toBe('/base/UserImage');
+        expect(url.searchParams.get('userId')).toBe('user');
+        expect(url.searchParams.get('tag')).toBe('cache');
+        expect(url.searchParams.get('format')).toBe('png');
+        const request = vi.spyOn(client, 'ajax').mockResolvedValue(undefined);
+        await client.deleteUserImage('user', ImageType.Primary, 0);
+        expect(request).toHaveBeenCalledWith({ type: 'DELETE', url: 'http://localhost:8096/base/UserImage?userId=user' });
+    });
+});
