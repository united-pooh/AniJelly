index 0000000..ccef82f
--- /dev/null
+++ b/src/apps/wizard/controllers/wizard.test.js
@@ -0,0 +1,92 @@
+import { beforeEach, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({ client: {}, navigate: vi.fn(), onServerChanged: vi.fn() }));
+vi.mock('lib/jellyfin-apiclient', () => ({ ServerConnections: { currentApiClient: () => mocks.client } }));
+vi.mock('utils/dashboard', () => ({ default: { navigate: mocks.navigate, onServerChanged: mocks.onServerChanged } }));
+vi.mock('components/loading/loading', () => ({ default: { show: vi.fn(), hide: vi.fn() } }));
+vi.mock('components/toast/toast', () => ({ default: vi.fn() }));
+vi.mock('lib/globalize', () => ({ default: { translate: key => key } }));
+vi.mock('utils/dom', () => ({ default: { parentWithClass: element => element.parentElement } }));
+vi.mock('elements/emby-button/emby-button', () => ({}));
+vi.mock('elements/emby-input/emby-input', () => ({}));
+vi.mock('elements/emby-select/emby-select', () => ({}));
+vi.mock('elements/emby-checkbox/emby-checkbox', () => ({}));
+
+import start from './start';
+import user from './user';
+import remote from './remote';
+
+beforeEach(() => {
+    vi.clearAllMocks();
+    mocks.navigate.mockResolvedValue(undefined);
+    mocks.client = {
+        getUrl: path => path,
+        accessToken: () => '',
+        getJSON: vi.fn().mockResolvedValue({}),
+        ajax: vi.fn().mockResolvedValue(undefined),
+        getPublicSystemInfo: vi.fn().mockResolvedValue({ ServerName: 'Server' }),
+        authenticateUserByName: vi.fn().mockResolvedValue({ User: { Id: 'admin' }, AccessToken: 'token' })
+    };
+    document.body.innerHTML = '<div class="skinHeader"></div><div class="page"></div>';
+});
+
+function show(controller, html) {
+    const view = document.querySelector('.page');
+    view.innerHTML = html;
+    controller(view);
+    view.dispatchEvent(new Event('viewshow'));
+    return view;
+}
+
+const userForm = '<form class="wizardUserForm"><input id="txtUsername" value="admin" /><input id="txtManualPassword" value="password" /><input id="txtPasswordConfirm" value="password" /></form>';
+
+it('requires administrator authentication before loading full server configuration', async () => {
+    show(start, '<form class="wizardStartForm"></form>');
+    await vi.waitFor(() => expect(mocks.navigate).toHaveBeenCalledWith('wizard/user'));
+    expect(mocks.client.getJSON).not.toHaveBeenCalled();
+});
+
+it('creates and authenticates the administrator before returning to server configuration', async () => {
+    const view = show(user, userForm);
+    expect(mocks.client.getJSON).not.toHaveBeenCalled();
+    view.querySelector('form').dispatchEvent(new Event('submit', { cancelable: true }));
+    await vi.waitFor(() => expect(mocks.navigate).toHaveBeenCalledWith('wizard/start'));
+    expect(mocks.client.ajax).toHaveBeenCalledWith(expect.objectContaining({ url: 'Startup/User', type: 'POST' }));
+    expect(mocks.client.authenticateUserByName).toHaveBeenCalledWith('admin', 'password');
+    expect(mocks.onServerChanged).toHaveBeenCalledWith('admin', 'token', mocks.client);
+});
+
+it('can resume interrupted setup with an existing administrator password', async () => {
+    mocks.client.ajax.mockRejectedValue({ status: 403 });
+    const view = show(user, userForm);
+    view.querySelector('form').dispatchEvent(new Event('submit', { cancelable: true }));
+    await vi.waitFor(() => expect(mocks.client.authenticateUserByName).toHaveBeenCalledWith('admin', 'password'));
+    expect(mocks.navigate).toHaveBeenCalledWith('wizard/start');
+});
+
+it('preserves the full network configuration when updating remote access', async () => {
+    const config = { EnableRemoteAccess: false, InternalHttpPort: 8096, KnownProxies: ['proxy.internal'] };
+    mocks.client.getJSON.mockResolvedValue(config);
+    const view = show(remote, '<form class="wizardSettingsForm"><input id="chkRemoteAccess" type="checkbox" /></form>');
+    view.querySelector('#chkRemoteAccess').checked = true;
+    view.querySelector('form').dispatchEvent(new Event('submit', { cancelable: true }));
+    await vi.waitFor(() => expect(mocks.client.ajax).toHaveBeenCalled());
+    const request = mocks.client.ajax.mock.calls[0][0];
+    expect(request.url).toBe('System/Configuration/network');
+    expect(JSON.parse(request.data)).toEqual({ ...config, EnableRemoteAccess: true });
+});
+
+it('preserves unrelated server configuration fields when saving the welcome page', async () => {
+    const config = { ServerName: 'Before', UICulture: 'en-US', EnableMetrics: true, MetadataOptions: [{ ItemType: 'Movie' }] };
+    mocks.client.accessToken = () => 'token';
+    mocks.client.getJSON.mockImplementation(path => Promise.resolve(path === 'Localization/Options' ? [{ Name: 'English', Value: 'en-US' }] : config));
+    const view = show(start, '<form class="wizardStartForm"><input id="txtServerName" /><select id="selectLocalizationLanguage"></select></form>');
+    await vi.waitFor(() => expect(view.querySelector('#txtServerName').value).toBe('Before'));
+    view.querySelector('#txtServerName').value = 'After';
+    view.querySelector('form').dispatchEvent(new Event('submit', { cancelable: true }));
+    await vi.waitFor(() => expect(mocks.client.ajax).toHaveBeenCalled());
+    const request = mocks.client.ajax.mock.calls[0][0];
+    expect(request.url).toBe('System/Configuration');
+    expect(JSON.parse(request.data)).toEqual({ ...config, ServerName: 'After' });
+    expect(mocks.navigate).toHaveBeenCalledWith('wizard/library');
+});
