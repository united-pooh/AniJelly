diff --git a/src/utils/jellyfin-apiclient/modernUserRoutes.ts b/src/utils/jellyfin-apiclient/modernUserRoutes.ts
new file mode 100644
index 0000000..bf0dfba
--- /dev/null
+++ b/src/utils/jellyfin-apiclient/modernUserRoutes.ts
@@ -0,0 +1,43 @@
+import type { ApiClient } from 'jellyfin-apiclient';
+
+function getUserRoute(path: string): string | undefined {
+    switch (path) {
+        case 'Items/Resume': return 'UserItems/Resume';
+        case 'Views': return 'UserViews';
+        case 'GroupingOptions': return 'UserViews/GroupingOptions';
+        case 'Suggestions': return 'Items/Suggestions';
+        case 'Password': return 'Users/Password';
+        case 'Configuration': return 'Users/Configuration';
+    }
+
+    if (/^Items\/[^/]+\/(UserData|Rating)$/.test(path)) return `User${path}`;
+    if (/^(PlayedItems|FavoriteItems)\/[^/]+$/.test(path)) return `User${path}`;
+    if (/^Items(?:\/[^/]+(?:\/(Intros|LocalTrailers|SpecialFeatures))?)?$/.test(path)) return path;
+    if (/^Images\/[^/]+(?:\/\d+)?$/.test(path)) return 'UserImage';
+    return undefined;
+}
+
+export function useModernUserRoutes(client: ApiClient): ApiClient {
+    const getUrl = client.getUrl.bind(client);
+    client.getUrl = (name, params, serverAddress) => {
+        const match = /^\/?Users\/([^/]+)\/(.+)$/.exec(name);
+        const path = match && getUserRoute(match[2]);
+        return path ? getUrl(path, { ...params, userId: match[1] }, serverAddress) : getUrl(name, params, serverAddress);
+    };
+
+    // GET and DELETE Users/{id} remain valid; only the update action moved.
+    client.updateUser = user => client.ajax({
+        type: 'POST',
+        url: getUrl('Users', { userId: user.Id }),
+        data: JSON.stringify(user),
+        contentType: 'application/json'
+    });
+
+    // The old client appends the optional image index after getUrl returns.
+    client.deleteUserImage = userId => client.ajax({
+        type: 'DELETE',
+        url: getUrl('UserImage', { userId })
+    });
+
+    return client;
+}
