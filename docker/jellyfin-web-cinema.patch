+@use './cinemaForm';
+
+.wizardPage .authBrand,
+.wizardStep,
+.wizardProgress {
+    display: none;
+}
+
+html[data-theme="cinema"] .wizardPage {
+    --wizard-page-top: 1.5rem;
+
+    @include cinemaForm.form;
+
+    background: var(--cinema-backdrop);
+
+    > .padded-left {
+        padding: 1rem 1.5rem;
+    }
+
+    .wizardContent {
+        @include cinemaForm.glass-surface(-1rem);
+
+        box-sizing: border-box;
+        width: 100%;
+        max-width: 30rem;
+        margin-inline: auto;
+        padding: 0;
+        background: transparent;
+        box-shadow: none;
+    }
+
+    .wizardStep {
+        display: block;
+        margin: 0 0 0.75rem;
+        color: var(--cinema-accent-violet);
+        font-size: 0.8125rem;
+        text-align: center;
+    }
+
+    .authDescription {
+        margin-bottom: 1.5rem;
+    }
+
+    .wizardProgress {
+        display: block;
+        width: 9rem;
+        height: 3px;
+        margin: 0 auto 1rem;
+        overflow: hidden;
+        border-radius: 3px;
+        background: rgba(197, 182, 255, 0.16);
+    }
+
+    .wizardProgress::after {
+        display: block;
+        width: var(--wizard-progress);
+        height: 100%;
+        border-radius: inherit;
+        background: linear-gradient(90deg, var(--cinema-accent-violet), var(--cinema-accent-mint));
+        content: "";
+    }
+
+    @for $step from 1 through 6 {
+        &[data-wizard-step="#{$step}"] {
+            --wizard-progress: calc(100% / 6 * #{$step});
+        }
+    }
+
+    .wizardNote {
+        margin-block: 1rem;
+        color: var(--jf-palette-text-secondary, #bcc4d3);
+        font-size: 0.8125rem;
+        text-align: center;
+    }
+
+    .wizardNavigation {
+        display: flex;
+        gap: 0.75rem;
+        margin-top: 1.5rem;
+    }
+
+    .wizardNavigation .raised {
+        margin: 0;
+    }
+
+    .wizardNavigation .button-submit {
+        flex: 1;
+    }
+
+    .wizardHelp {
+        margin-top: 1.5rem;
+        color: var(--jf-palette-text-secondary, #bcc4d3);
+        font-size: 0.875rem;
+        text-align: center;
+    }
+
+    #divVirtualFolders .card {
+        width: 50%;
+    }
+
+    @media (max-width: 40em) {
+        .wizardContent::before {
+            inset-inline: -0.5rem;
+        }
+    }
+}
