+.cinemaHomeTitle {
+    display: none;
+}
+
+html[data-theme="cinema"] {
+    .cinemaSidebar .MuiDrawer-paper {
+        padding: 1.2rem 0.75rem 5rem;
+        border-right: 1px solid var(--cinema-glass-border);
+        background: var(--cinema-glass-fallback);
+        box-shadow: none;
+    }
+
+    .cinemaSidebar .MuiListItemButton-root {
+        min-height: 44px;
+        margin-bottom: 4px;
+        padding: 0.55rem 0.85rem;
+        border-radius: 14px;
+    }
+
+    .cinemaSidebar .MuiListItemButton-root.Mui-selected {
+        color: var(--jf-palette-primary-contrastText);
+        background: var(--jf-palette-primary-main);
+
+        &:hover {
+            background: var(--jf-palette-primary-dark);
+        }
+    }
+
+    .cinemaSidebar .MuiListItemText-primary {
+        overflow: hidden;
+        font-size: 0.95rem;
+        text-overflow: ellipsis;
+        white-space: nowrap;
+    }
+
+    .cinemaSidebar .MuiListItemIcon-root {
+        min-width: 36px;
+    }
+
+    .cinemaSidebar .MuiListItemButton-root.Mui-selected .MuiListItemIcon-root {
+        color: inherit;
+    }
+
+    .cinemaSidebar .cinemaBrand {
+        margin-bottom: 1rem;
+    }
+
+    .cinemaSidebar .cinemaBrand .MuiListItemText-primary {
+        font-size: 1.25rem;
+        font-weight: 700;
+        letter-spacing: -0.04em;
+    }
+
+    .cinemaSidebar .cinemaBrand .MuiListItemText-secondary {
+        overflow: hidden;
+        font-size: 0.75rem;
+        text-overflow: ellipsis;
+        white-space: nowrap;
+    }
+
+    .cinemaSidebar .cinemaUserLink {
+        margin-bottom: 1rem;
+    }
+
+    .cinemaSidebar .MuiDivider-root {
+        margin: 0.8rem;
+    }
+
+    .cinemaSidebarSettings {
+        margin-top: auto;
+    }
+
+    .cinemaLibraryDocument {
+        .skinHeader {
+            inset-inline-start: 240px;
+            width: auto;
+        }
+
+        .mainAnimatedPage {
+            left: 240px;
+        }
+
+        .mainDrawerButton,
+        .pageTitleWithDefaultLogo {
+            display: none;
+        }
+    }
+
+    .cinemaHomeTitle {
+        display: block;
+        margin: 0 0 1.2rem;
+        font-size: clamp(1.8rem, 3vw, 2.4rem);
+        font-weight: 700;
+        letter-spacing: -0.045em;
+    }
+
+    .homePage .sectionTitle {
+        font-weight: 650;
+        letter-spacing: -0.025em;
+    }
+
+    .homePage .cardBox {
+        border-radius: 14px;
+    }
+
+    .cinemaEmptyLibrary {
+        position: relative;
+        display: flex;
+        align-items: center;
+        min-height: 430px;
+        box-sizing: border-box;
+        margin: 0 3.3%;
+        padding: clamp(1.5rem, 5vw, 4rem);
+        overflow: hidden;
+        border: 1px solid var(--jf-palette-divider);
+        border-radius: 22px;
+        background: var(--cinema-backdrop);
+    }
+
+    .cinemaEmptyLibraryContent {
+        position: relative;
+        max-width: 34rem;
+    }
+
+    .cinemaEmptyLibraryIcon {
+        display: block;
+        margin-bottom: 1.2rem;
+        color: var(--jf-palette-primary-main);
+        font-size: 3.2rem;
+    }
+
+    .cinemaEmptyLibrary h2 {
+        margin: 0 0 0.8rem;
+        font-size: clamp(1.7rem, 2.5vw, 2.5rem);
+        font-weight: 700;
+        letter-spacing: -0.04em;
+        line-height: 1.2;
+    }
+
+    .cinemaEmptyLibrary p {
+        max-width: 30rem;
+        margin: 0 0 1.8rem;
+        color: var(--jf-palette-text-secondary);
+        font-size: 1.05rem;
+        line-height: 1.65;
+    }
+
+    .cinemaEmptyLibrary .emby-button {
+        min-width: 10rem;
+        padding: 0.85rem 1.5rem;
+        border-radius: 16px;
+        color: var(--jf-palette-primary-contrastText);
+        background: var(--jf-palette-primary-main);
+        box-shadow: none;
+        font-weight: 650;
+    }
+
+    .cinemaSidebar a:focus-visible,
+    .cinemaEmptyLibrary .emby-button:focus-visible {
+        outline: 3px solid var(--jf-palette-secondary-main);
+        outline-offset: 3px;
+        box-shadow: 0 0 0 3px var(--jf-palette-background-default), 0 0 0 6px var(--jf-palette-secondary-main);
+    }
+
+    .cinemaEmptyLibrary .emby-button:hover:not(:disabled) {
+        background: var(--jf-palette-primary-dark);
+    }
+
+    @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
+        .cinemaSidebar .MuiDrawer-paper {
+            background: var(--cinema-glass-sheen), var(--cinema-glass-bg);
+            box-shadow: var(--cinema-glass-shadow);
+            backdrop-filter: var(--cinema-glass-filter);
+        }
+    }
+
+    @media (max-width: 899px) {
+        .cinemaHomeTitle {
+            font-size: 1.9rem;
+        }
+
+        .cinemaEmptyLibrary {
+            min-height: 370px;
+            margin: 0 5%;
+            padding: 2rem 1.5rem;
+        }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        .homePage .cardBox {
+            transition: none;
+        }
+    }
+}
