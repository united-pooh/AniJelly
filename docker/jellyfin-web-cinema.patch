@@ -0,0 +1,16 @@
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { expect, it } from 'vitest';
+
+it('starts administrator setup without a back action and preserves later back navigation', () => {
+    const template = document.createElement('template');
+    template.innerHTML = readFileSync(join(import.meta.dirname, 'user/index.html'), 'utf8');
+    expect(template.content.querySelector('.button-cancel')).toBeNull();
+    expect(template.content.querySelector('.wizardPage').dataset.backbutton).toBe('false');
