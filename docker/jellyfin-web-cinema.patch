@@ -0,0 +1,33 @@
+import useMediaQuery from '@mui/material/useMediaQuery';
+import React, { useEffect } from 'react';
+import { useLocation } from 'react-router-dom';
+
+import AppDrawer, { isDrawerPath } from 'apps/modern/components/drawers/AppDrawer';
+import layoutManager from 'components/layoutManager';
+import { useApi } from 'hooks/useApi';
+import { useUserTheme } from 'hooks/useUserTheme';
+import globalize from 'lib/globalize';
+
+import '../../styles/cinema-library.scss';
+
+const onDrawerChange = () => undefined;
+
+export default function CinemaSidebar() {
+    const { user } = useApi();
+    const { theme } = useUserTheme();
+    const { pathname } = useLocation();
+    const isDesktop = useMediaQuery('(min-width: 900px)');
+    const isVisible = theme === 'cinema' && !!user && isDesktop
+        && !layoutManager.tv && isDrawerPath(pathname);
+
+    useEffect(() => {
+        document.body.classList.toggle('cinemaLibraryDocument', isVisible);
+        return () => document.body.classList.remove('cinemaLibraryDocument');
+    }, [isVisible]);
+
+    return isVisible ? (
+        <nav className='cinemaSidebar' aria-label={globalize.translate('Menu')}>
+            <AppDrawer open onOpen={onDrawerChange} onClose={onDrawerChange} />
+        </nav>
+    ) : null;
+}
