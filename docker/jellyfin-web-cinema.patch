@@ -0,0 +1,288 @@
+@use '../_base/theme' with (
+    $background-default: #0b0b0d,
+    $background-paper: #171c2a,
+    $primary-main: #8bbcff,
+    $primary-dark: #72a7eb,
+    $primary-light: #acd1ff,
+    $primary-hover: rgba(139, 188, 255, 0.08),
+    $primary-contrastText: #0b0b0d,
+    $secondary-main: #0a84ff,
+    $secondary-contrastText: #fff,
+    $text-primary: #f5f5f7,
+    $text-secondary: #bcc4d3,
+    $error-main: #ff453a,
+    $error-dark: #e23d33,
+    $error-light: #ff6961,
+    $error-contrastText: #0b0b0d,
+    $divider: rgba(173, 195, 236, 0.2),
+    $action-focus: rgba(10, 132, 255, 0.24),
+    $action-hover: rgba(139, 188, 255, 0.08),
+    $alert-infoFilledBg: #172b40,
+    $alert-infoFilledColor: #d6e9ff,
+    $appBar-defaultBg: #171c2a,
+    $appBar-transparentBg: #171c2a,
+    $filledInput-bg: #242c40,
+    $filledInput-borderColor: rgba(173, 195, 236, 0.2),
+    $card-borderRadius: 0.85rem,
+    $button-inheritContainedBg: #252d40,
+    $button-inheritContainedHoverBg: #303c55,
+    $snackbarContent-bg: #20283b,
+    $snackbarContent-color: #f5f5f7
+);
+
+html[data-theme="cinema"] {
+    --jf-font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", system-ui, sans-serif;
+    --cinema-backdrop: radial-gradient(ellipse 48% 58% at 20% 24%, rgba(77, 131, 219, 0.5), transparent 100%), radial-gradient(ellipse 50% 60% at 82% 35%, rgba(141, 103, 206, 0.46), transparent 100%), radial-gradient(ellipse 44% 48% at 58% 92%, rgba(39, 156, 135, 0.32), transparent 100%), #0b0b0d;
+    --cinema-accent-violet: #c5b6ff;
+    --cinema-accent-mint: #75d9c4;
+    --cinema-glass-bg: rgba(8, 12, 22, 0.78);
+    --cinema-auth-glass-bg: rgba(12, 19, 35, 0.45);
+    --cinema-glass-sheen: linear-gradient(135deg, rgba(255, 255, 255, 0.075), rgba(139, 188, 255, 0.025) 24%, transparent 46%, rgba(197, 182, 255, 0.035) 76%, rgba(117, 217, 196, 0.025));
+    --cinema-glass-filter: blur(14px) saturate(160%);
+    --cinema-glass-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), inset 0 -1px 0 rgba(0, 0, 0, 0.38), 0 8px 24px rgba(0, 0, 0, 0.14);
+    --cinema-glass-fallback: #171c2a;
+    --cinema-glass-border: rgba(221, 232, 255, 0.38);
+
+    color: #f5f5f7;
+    color-scheme: dark;
+    font-family: var(--jf-font-family);
+    background: var(--cinema-backdrop);
+
+    body,
+    .backgroundContainer:not(.withBackdrop) {
+        background: var(--cinema-backdrop);
+    }
+
+    body,
+    input,
+    select,
+    textarea,
+    button {
+        font-family: var(--jf-font-family);
+    }
+
+    .emby-input,
+    .emby-select-withcolor,
+    .emby-textarea {
+        border-width: 1px;
+        border-radius: 14px;
+        color: #f5f5f7;
+    }
+
+    .emby-button.raised,
+    .button-submit,
+    .button-delete {
+        border-radius: 16px;
+        font-weight: 600;
+        box-shadow: none;
+    }
+
+    .button-delete {
+        background: #ff453a;
+        color: #0b0b0d;
+
+        &:focus,
+        &:hover:not(:disabled) {
+            background: #e23d33;
+            color: #0b0b0d;
+        }
+    }
+
+    .emby-checkbox:checked:not(:disabled) + span + .checkboxOutline {
+        border-color: #0a84ff;
+        background-color: #0a84ff;
+        color: #fff;
+    }
+
+    .mainDrawer,
+    .dialog,
+    .skinHeader-withBackground,
+    .skinHeader.semiTransparent {
+        background: var(--cinema-glass-fallback);
+        box-shadow: none;
+    }
+
+    .mainDrawer {
+        border-inline-end: 1px solid var(--cinema-glass-border);
+    }
+
+    .mainDrawer .navMenuOption {
+        border-radius: 14px;
+    }
+
+    .dialog:not(.dialog-fullscreen):not(.dialog-fixedSize) {
+        border: 1px solid var(--cinema-glass-border);
+        border-radius: 16px;
+    }
+
+    .skinHeader-withBackground,
+    .skinHeader.semiTransparent {
+        border-bottom: 1px solid var(--cinema-glass-border);
+    }
+
+    @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
+        .mainDrawer,
+        .dialog,
+        .skinHeader-withBackground,
+        .skinHeader.semiTransparent {
+            background: var(--cinema-glass-sheen), var(--cinema-glass-bg);
+            box-shadow: var(--cinema-glass-shadow);
+            backdrop-filter: var(--cinema-glass-filter);
+        }
+
+        .skinHeader.semiTransparent {
+            backdrop-filter: var(--cinema-glass-filter) !important;
+        }
+    }
+
+    .dashboardDocument {
+        .MuiDrawer-paper {
+            background: var(--cinema-glass-fallback);
+            border-right: 1px solid var(--cinema-glass-border);
+            border-radius: 0;
+        }
+
+        @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
+            .MuiDrawer-paper {
+                background: var(--cinema-glass-sheen), var(--cinema-glass-bg);
+                box-shadow: var(--cinema-glass-shadow);
+                backdrop-filter: var(--cinema-glass-filter);
+            }
+        }
+
+        .MuiDrawer-paper .MuiList-root {
+            padding: 0.5rem 0.75rem;
+        }
+
+        .MuiDrawer-paper .MuiListItemButton-root {
+            min-height: 44px;
+            margin-block: 0.15rem;
+            padding-block: 0.5rem;
+            padding-inline: 0.75rem;
+            border-radius: 14px;
+        }
+
+        .MuiDrawer-paper .MuiListItemButton-root.Mui-selected {
+            background: #8bbcff;
+            color: #0b0b0d;
+
+            .MuiListItemIcon-root {
+                color: inherit;
+            }
+
+            &:hover {
+                background: #72a7eb;
+            }
+        }
+
+        .MuiDrawer-paper .MuiListSubheader-root {
+            margin-top: 0.5rem;
+            padding-inline: 0.75rem;
+            color: var(--jf-palette-text-secondary, #bcc4d3);
+            font-size: 0.75rem;
+            line-height: 2.5;
+        }
+
+        .cinema-dashboard-account {
+            padding-inline: 0.75rem;
+            color: var(--jf-palette-text-secondary, #bcc4d3);
+
+            .MuiAvatar-root {
+                background-color: var(--cinema-accent-violet);
+                color: #0b0b0d;
+            }
+        }
+
+        .content-primary {
+            padding: 1.5rem clamp(1rem, 3vw, 3rem) 5rem;
+        }
+
+        .MuiTypography-root,
+        .MuiListItemText-root {
+            overflow-wrap: anywhere;
+        }
+
+        .MuiGrid-item,
+        .MuiStack-root {
+            min-width: 0;
+        }
+
+        #dashboardPage .MuiPaper-root,
+        #dashboardPage .MuiList-root {
+            border: 1px solid var(--jf-palette-divider);
+            border-radius: 1rem;
+        }
+
+        #dashboardGeneralPage .content-primary {
+            max-width: 60rem;
+            box-sizing: border-box;
+        }
+
+        .cinema-settings-group {
+            padding: 1.5rem;
+            border: 1px solid var(--jf-palette-divider);
+            border-radius: 1rem;
+            background: rgba(23, 28, 42, 0.82);
+
+            .MuiTypography-h2 {
+                color: var(--cinema-accent-mint);
+            }
+        }
+
+        .cinema-settings-actions {
+            display: flex;
+            justify-content: flex-end;
+
+            .MuiButton-root {
+                min-width: 10rem;
+            }
+        }
+
+        @media (max-width: 599px) {
+            .content-primary {
+                padding-top: 1rem;
+            }
+
+            .cinema-settings-group {
+                padding: 1rem;
+            }
+
+            .cinema-settings-actions .MuiButton-root {
+                width: 100%;
+            }
+        }
+    }
+
+    a:focus-visible,
+    button:focus-visible,
+    input:focus-visible,
+    select:focus-visible,
+    textarea:focus-visible,
+    [tabindex]:focus-visible {
+        outline: 2px solid #0a84ff;
+        outline-offset: 3px;
+    }
+
+    .emby-button:focus-visible {
+        box-shadow: 0 0 0 3px #0b0b0d, 0 0 0 6px #0a84ff;
+    }
+
+    @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
+        --cinema-glass-bg: var(--cinema-glass-fallback);
+        --cinema-auth-glass-bg: var(--cinema-glass-fallback);
+        --cinema-glass-sheen: none;
+        --cinema-glass-filter: none;
+        --cinema-glass-shadow: none;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        *,
+        *::before,
+        *::after {
+            animation-duration: 0.01ms !important;
+            animation-iteration-count: 1 !important;
+            transition-duration: 0.01ms !important;
+            scroll-behavior: auto !important;
+        }
+    }
+}
