+@mixin glass-surface($inline-inset: 0) {
+    position: relative;
+    isolation: isolate;
+
+    &::before {
+        position: absolute;
+        z-index: -1;
+        inset: -0.75rem $inline-inset;
+        border: 1px solid var(--cinema-glass-border);
+        border-radius: 1.25rem;
+        background: var(--cinema-glass-fallback);
+        content: "";
+        pointer-events: none;
+    }
+
+    @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
+        &::before {
+            background: var(--cinema-glass-sheen), var(--cinema-auth-glass-bg);
+            box-shadow: var(--cinema-glass-shadow);
+            backdrop-filter: var(--cinema-glass-filter);
+        }
+    }
+}
+
+@mixin form {
+    color: #f5f5f7;
+    font-size: 16px;
+    line-height: 1.5;
+
+    .authBrand {
+        display: flex;
+        align-items: center;
+        justify-content: center;
+        gap: 0.4rem;
+        margin-bottom: 1.5rem;
+        font-size: 1.25rem;
+        font-weight: 650;
+        letter-spacing: -0.02em;
+    }
+
+    .authBrand .material-icons {
+        color: var(--cinema-accent-mint);
+        font-size: 2rem;
+    }
+
+    .authTitle {
+        display: block;
+        margin: 0 0 0.75rem;
+        font-size: 2.5rem;
+        font-weight: 650;
+        line-height: 1.2;
+        letter-spacing: -0.035em;
+        text-align: center;
+        text-wrap: balance;
+    }
+
+    .authDescription {
+        margin: 0 0 2rem;
+        color: var(--jf-palette-text-secondary, #bcc4d3);
+        font-size: 1rem;
+        line-height: 1.6;
+        text-align: center;
+    }
+
+    .inputContainer,
+    .selectContainer {
+        margin-bottom: 1.25rem;
+    }
+
+    .inputLabel,
+    .selectLabel {
+        margin-bottom: 0.5rem;
+        color: #f5f5f7;
+        font-size: 0.875rem;
+        font-weight: 500;
+    }
+
+    .emby-input,
+    .emby-select {
+        box-sizing: border-box;
+        min-height: 3.25rem;
+        padding: 0.8rem 1rem;
+        border: 1px solid var(--cinema-glass-border);
+        border-radius: 0.75rem;
+        background: rgba(245, 245, 247, 0.06);
+        color: #f5f5f7;
+        font-size: 16px;
+    }
+
+    .emby-select {
+        padding-inline-end: 2.75rem;
+    }
+
+    .emby-input:focus,
+    .emby-select:focus {
+        border-color: #0a84ff;
+        box-shadow: 0 0 0 3px rgba(10, 132, 255, 0.4);
+    }
+
+    .fieldDescription {
+        margin-top: 0.5rem;
+        color: var(--jf-palette-text-secondary, #bcc4d3);
+        font-size: 0.8125rem;
+        line-height: 1.5;
+    }
+
+    .checkboxContainer {
+        margin-block: 1.5rem;
+    }
+
+    .raised {
+        min-height: 3rem;
+        padding: 0.75rem 1.25rem;
+        border-radius: 1rem;
+        font-size: 1rem;
+        font-weight: 600;
+        box-shadow: none;
+    }
+
+    .button-submit {
+        background: var(--jf-palette-primary-main, #8bbcff);
+        color: var(--jf-palette-primary-contrastText, #0b0b0d);
+    }
+
+    .button-cancel,
+    .cancel,
+    .btnSelectServer {
+        border: 1px solid rgba(245, 245, 247, 0.14);
+        background: transparent;
+        color: #f5f5f7;
+        box-shadow: none;
+    }
+
+    .raised:focus-visible {
+        box-shadow: 0 0 0 3px #0a84ff;
+    }
+
+    .raised:disabled {
+        opacity: 0.45;
+    }
+
+    @media (max-width: 40em) {
+        .authTitle {
+            font-size: 2rem;
+        }
+    }
+}
