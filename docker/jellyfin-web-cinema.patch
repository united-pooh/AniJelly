diff --git a/src/apps/legacy/controllers/hometab.test.js b/src/apps/legacy/controllers/hometab.test.js
new file mode 100644
index 0000000000..d7f3b49030
--- /dev/null
+++ b/src/apps/legacy/controllers/hometab.test.js
@@ -0,0 +1,114 @@
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({ getCurrentUser: vi.fn(), fetchUserViews: vi.fn(), autoFocus: vi.fn() }));
+vi.mock('scripts/settings/userSettings', () => ({ get: vi.fn() }));
+vi.mock('components/focusManager', () => ({ default: { autoFocus: mocks.autoFocus } }));
+vi.mock('components/layoutManager', () => ({ default: { tv: false } }));
+vi.mock('lib/jellyfin-apiclient', () => ({ ServerConnections: { currentApiClient: () => ({ getCurrentUser: mocks.getCurrentUser, serverId: () => 'server' }) } }));
+vi.mock('lib/jellyfin-apiclient/ServerConnections', () => ({ default: { getApi: () => ({}) } }));
+vi.mock('hooks/api/useUserViews', () => ({ fetchUserViews: mocks.fetchUserViews }));
+vi.mock('lib/globalize', () => ({ default: { translate: key => key } }));
+vi.mock('utils/dashboard', () => ({ default: { navigate: vi.fn() } }));
+vi.mock('components/homesections/sections/activeRecordings', () => ({ loadRecordings: vi.fn() }));
+vi.mock('components/homesections/sections/libraryButtons', () => ({ loadLibraryButtons: vi.fn() }));
+vi.mock('components/homesections/sections/libraryTiles', () => ({ loadLibraryTiles: vi.fn() }));
+vi.mock('components/homesections/sections/liveTv', () => ({ loadLiveTV: vi.fn() }));
+vi.mock('components/homesections/sections/nextUp', () => ({ loadNextUp: vi.fn() }));
+vi.mock('components/homesections/sections/recentlyAdded', () => ({ loadRecentlyAdded: vi.fn() }));
+vi.mock('components/homesections/sections/resume', () => ({ loadResume: vi.fn() }));
+vi.mock('elements/emby-button/paper-icon-button-light', () => ({}));
+vi.mock('elements/emby-button/emby-button', () => ({}));
+vi.mock('elements/emby-itemscontainer/emby-itemscontainer', () => ({}));
+vi.mock('elements/emby-scroller/emby-scroller', () => ({}));
+
+import HomeTab from './hometab';
+
+let view;
+let tab;
+let completeViews;
+
+beforeEach(() => {
+    vi.clearAllMocks();
+    document.documentElement.dataset.theme = 'cinema';
+    document.body.innerHTML = '<div id="homeTab"><div class="sections"></div></div>';
+    view = document.querySelector('#homeTab');
+    mocks.getCurrentUser.mockResolvedValue({ Id: 'user', Policy: { IsAdministrator: true } });
+    mocks.fetchUserViews.mockImplementation(() => new Promise(resolve => {
+        completeViews = resolve;
+    }));
+    tab = new HomeTab(view, {});
+});
+
+afterEach(() => {
+    tab.destroy();
+    document.body.innerHTML = '';
+    delete document.documentElement.dataset.theme;
+    vi.restoreAllMocks();
+});
+
+it('shares an in-flight load and marks the page rendered only after its content is ready', async () => {
+    const first = tab.onResume({});
+    const second = tab.onResume({});
+    const markedBeforeContent = tab.sectionsRendered;
+    await vi.waitFor(() => expect(mocks.fetchUserViews).toHaveBeenCalledOnce());
+    completeViews({ Items: [] });
+    await Promise.all([first, second]);
+
+    expect(second).toBe(first);
+    expect(markedBeforeContent).not.toBe(true);
+    expect(tab.sectionsRendered).toBe(true);
+    expect(view.querySelectorAll('.cinemaEmptyLibrary')).toHaveLength(1);
+});
+
+it('does not render or focus a page destroyed while its media-library request was pending', async () => {
+    const load = tab.onResume({ autoFocus: true });
+    await vi.waitFor(() => expect(mocks.fetchUserViews).toHaveBeenCalledOnce());
+    tab.destroy();
+    completeViews({ Items: [] });
+    await load;
+
+    expect(view.querySelector('.cinemaEmptyLibrary')).toBeNull();
+    expect(mocks.autoFocus).not.toHaveBeenCalled();
+    expect(tab.sectionsRendered).not.toBe(true);
+});
+
+it('propagates a failed load and permits a later resume to load the page again', async () => {
+    const error = new Error('Request failed');
+    const reportError = vi.spyOn(console, 'error').mockImplementation(() => undefined);
+    mocks.fetchUserViews.mockRejectedValueOnce(error);
+    await expect(tab.onResume({})).rejects.toBe(error);
+    expect(tab.sectionsRendered).not.toBe(true);
+    expect(reportError).toHaveBeenCalledWith('Error loading home sections', error);
+
+    mocks.fetchUserViews.mockResolvedValueOnce({ Items: [] });
+    await tab.onResume({});
+    expect(mocks.fetchUserViews).toHaveBeenCalledTimes(2);
+    expect(view.querySelector('.cinemaEmptyLibrary')).not.toBeNull();
+});
+
+it('reports a failed event-triggered load when its returned promise is ignored', async () => {
+    const error = new Error('Request failed');
+    const reportError = vi.spyOn(console, 'error').mockImplementation(() => undefined);
+    mocks.fetchUserViews.mockRejectedValueOnce(error);
+
+    tab.onResume({});
+
+    await vi.waitFor(() => expect(reportError).toHaveBeenCalledWith('Error loading home sections', error));
+    expect(tab.sectionsLoad).toBeNull();
+    expect(tab.sectionsRendered).toBe(false);
+});
+
+it('does not start a library load if the page was destroyed while the user was loading', async () => {
+    let completeUser;
+    mocks.fetchUserViews.mockResolvedValueOnce({ Items: [] });
+    mocks.getCurrentUser.mockImplementationOnce(() => new Promise(resolve => {
+        completeUser = resolve;
+    }));
+    const load = tab.onResume({});
+    tab.destroy();
+    completeUser({ Id: 'user' });
+    await load;
+
+    expect(mocks.fetchUserViews).not.toHaveBeenCalled();
+    expect(mocks.autoFocus).not.toHaveBeenCalled();
