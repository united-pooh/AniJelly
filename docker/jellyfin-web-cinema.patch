diff --git a/src/hooks/api/useUserViews.test.ts b/src/hooks/api/useUserViews.test.ts
new file mode 100644
index 0000000000..009cda0875
--- /dev/null
+++ b/src/hooks/api/useUserViews.test.ts
@@ -0,0 +1,72 @@
+import type { Api } from '@jellyfin/sdk/lib/api';
+import type { BaseItemDtoQueryResult } from '@jellyfin/sdk/lib/generated-client/models/base-item-dto-query-result';
+import { CancelledError, QueryObserver } from '@tanstack/react-query';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({ getUserViews: vi.fn() }));
+vi.mock('@jellyfin/sdk/lib/utils/api/user-view-api', () => ({ getUserViewApi: () => mocks }));
+vi.mock('../useApi', () => ({ useApi: vi.fn() }));
+
+import { queryClient } from 'utils/query/queryClient';
+import { fetchUserViews, getUserViewsQuery } from './useUserViews';
+
+const api = {} as Api;
+const params = { userId: 'user' };
+const data = { Items: [], TotalRecordCount: 0 };
+let finishRequest: (response: { data: BaseItemDtoQueryResult }) => void;
+let rejectRequest: (error: Error) => void;
+
+beforeEach(() => {
+    mocks.getUserViews.mockReset();
+    mocks.getUserViews.mockImplementation(() => new Promise((resolve, reject) => {
+        finishRequest = resolve;
+        rejectRequest = reject;
+    }));
+});
+
+afterEach(() => queryClient.clear());
+
+it.each([true, false])('keeps an imperative load alive when the sidebar unmounts (sidebar first: %s)', async sidebarFirst => {
+    const options = getUserViewsQuery(api, params);
+    const sidebar = new QueryObserver(queryClient, options);
+    let unsubscribe: () => void = () => undefined;
+    if (sidebarFirst) unsubscribe = sidebar.subscribe(() => undefined);
+    const load = fetchUserViews(api, params);
+    const outcome = load.then(value => ({ value }), error => ({ error }));
+    if (!sidebarFirst) unsubscribe = sidebar.subscribe(() => undefined);
+    const signal = mocks.getUserViews.mock.calls[0][1].signal as AbortSignal;
+
+    unsubscribe();
+    finishRequest({ data });
+
+    expect(await outcome).toEqual({ value: data });
+    expect(signal.aborted).toBe(false);
+    expect(mocks.getUserViews).toHaveBeenCalledTimes(1);
+    expect(queryClient.getQueryCache().find(options)?.getObserversCount()).toBe(0);
+    await expect(fetchUserViews(api, params)).resolves.toEqual(data);
+    expect(mocks.getUserViews).toHaveBeenCalledTimes(1);
+});
+
+it('still propagates explicit cancellation and releases its observer', async () => {
+    const options = getUserViewsQuery(api, params);
+    const load = fetchUserViews(api, params);
+    const outcome = load.catch(error => error);
+    const signal = mocks.getUserViews.mock.calls[0][1].signal as AbortSignal;
+    await queryClient.cancelQueries({ queryKey: options.queryKey });
+
+    expect(await outcome).toBeInstanceOf(CancelledError);
+    expect(signal.aborted).toBe(true);
+    expect(queryClient.getQueryCache().find(options)?.getObserversCount()).toBe(0);
+    finishRequest({ data });
+});
+
+it('propagates a failed request and releases its observer', async () => {
+    const options = getUserViewsQuery(api, params);
+    const error = Object.assign(new Error('Unauthorized'), { status: 401 });
+    const load = fetchUserViews(api, params);
+    const outcome = load.catch(reason => reason);
+    rejectRequest(error);
+
+    expect(await outcome).toBe(error);
+    expect(queryClient.getQueryCache().find(options)?.getObserversCount()).toBe(0);
+});
