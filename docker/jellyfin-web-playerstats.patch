+++ b/src/components/playerstats/playerstats.test.js
@@ -0,0 +1,203 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import Events from 'utils/events';
+import { playbackManager } from '../playback/playbackmanager';
+import PlayerStats from './playerstats';
+
+const mocks = vi.hoisted(() => ({ getSessions: vi.fn() }));
+vi.mock('lib/globalize', () => ({ default: { translate: key => key } }));
+vi.mock('lib/jellyfin-apiclient', () => ({
+    ServerConnections: {
+        getApiClient: () => ({ getSessions: mocks.getSessions, deviceId: () => 'device' })
+    }
+}));
+vi.mock('../layoutManager', () => ({ default: { tv: false } }));
+vi.mock('../playback/playbackmanager', () => ({
+    playbackManager: {
+        playSessionId: vi.fn(),
+        currentItem: vi.fn(),
+        currentMediaSource: vi.fn(),
+        getAudioStreamIndex: vi.fn(() => 1),
+        audioTracks: vi.fn(() => [{ Type: 'Audio', Index: 1, Codec: 'aac' }])
+    }
+}));
+vi.mock('../pluginManager', () => ({ pluginManager: { firstOfType: () => undefined } }));
+vi.mock('elements/emby-button/paper-icon-button-light', () => ({}));
+
+const source = {
+    Id: 'source', Container: 'mp4',
+    MediaStreams: [{ Type: 'Video', Codec: 'h264', Width: 1920, Height: 1080 }]
+};
+const session = {
+    NowPlayingItem: { Id: 'item' },
+    PlayState: { PlayMethod: 'DirectPlay', PlaySessionId: 'play-session' }
+};
+function deferred() {
+    let resolve;
+    let reject;
+    const promise = new Promise((a, b) => {
+        resolve = a;
+        reject = b;
+    });
+    return { promise, resolve, reject };
+}
+async function flush() {
+    for (let i = 0; i < 12; i++) await Promise.resolve();
+}
+const content = () => document.querySelector('.playerStats-stats')?.textContent;
+let panel;
+let player;
+
+beforeEach(() => {
+    vi.useFakeTimers();
+    vi.clearAllMocks();
+    playbackManager.playSessionId.mockReturnValue('play-session');
+    playbackManager.currentItem.mockReturnValue({ Id: 'item', ServerId: 'server' });
+    playbackManager.currentMediaSource.mockReturnValue(source);
+    player = {
+        name: 'HTML Video',
+        getStats: vi.fn().mockResolvedValue({ categories: [{ stats: [{ label: 'Sizes', value: '1920x1080' }] }] })
+    };
+    mocks.getSessions.mockResolvedValue([session]);
+});
+afterEach(() => {
+    panel?.destroy();
+    panel = null;
+    document.body.innerHTML = '';
+    vi.useRealTimers();
+});
+
+describe('playback information latency', () => {
+    it('renders media information synchronously while paused without timeupdate', () => {
+        panel = new PlayerStats({ player });
+        expect(content()).toContain('H264');
+        expect(content()).toContain('mp4');
+        expect(content()).not.toContain('null');
+    });
+
+    it('shows local player data while the server session is still pending', async () => {
+        mocks.getSessions.mockReturnValue(deferred().promise);
+        panel = new PlayerStats({ player });
+        await flush();
+        expect(content()).toContain('1920x1080');
+        expect(content()).toContain('H264');
+    });
+
+    it('does not pile up either request while a slow request is in flight', async () => {
+        mocks.getSessions.mockReturnValue(deferred().promise);
+        player.getStats.mockReturnValue(deferred().promise);
+        panel = new PlayerStats({ player });
+        for (let i = 0; i < 6; i++) {
+            Events.trigger(player, 'timeupdate');
+            await vi.advanceTimersByTimeAsync(800);
+        }
+        expect(mocks.getSessions).toHaveBeenCalledTimes(1);
+        expect(player.getStats).toHaveBeenCalledTimes(1);
+        expect(content()).toContain('H264');
+    });
+
+    it('shows server information even if player statistics never resolve', async () => {
+        player.getStats.mockReturnValue(deferred().promise);
+        panel = new PlayerStats({ player });
+        await flush();
+        expect(content()).toContain('DirectPlaying');
+        expect(content()).toContain('H264');
+    });
+
+    it('keeps metadata visible and backs off after a server error', async () => {
+        vi.spyOn(console, 'warn').mockImplementation(() => undefined);
+        mocks.getSessions.mockRejectedValue(new Error('offline'));
+        player.getStats.mockRejectedValue(new Error('player unavailable'));
+        panel = new PlayerStats({ player });
+        await flush();
+        await vi.advanceTimersByTimeAsync(800);
+        Events.trigger(player, 'timeupdate');
+        await flush();
+        expect(content()).toContain('H264');
+        expect(mocks.getSessions).toHaveBeenCalledTimes(1);
+        expect(console.warn).toHaveBeenCalled();
+    });
+
+    it('caches sessions for ten seconds then refreshes', async () => {
+        panel = new PlayerStats({ player });
+        await flush();
+        await vi.advanceTimersByTimeAsync(9000);
+        Events.trigger(player, 'timeupdate');
+        await flush();
+        expect(mocks.getSessions).toHaveBeenCalledTimes(1);
+        await vi.advanceTimersByTimeAsync(1000);
+        Events.trigger(player, 'timeupdate');
+        await flush();
+        expect(mocks.getSessions).toHaveBeenCalledTimes(2);
+    });
+
+    it('does not update hidden content but refreshes immediately on reopening', async () => {
+        const pending = deferred();
+        mocks.getSessions.mockReturnValue(pending.promise);
+        panel = new PlayerStats({ player });
+        const initial = content();
+        panel.enabled(false);
+        pending.resolve([session]);
+        await flush();
+        expect(content()).toBe(initial);
+        panel.enabled(true);
+        expect(content()).toContain('DirectPlaying');
+        expect(content()).toContain('1920x1080');
+        expect(mocks.getSessions).toHaveBeenCalledTimes(1);
+    });
+
+    it('ignores pending results after destruction and removes event listeners', async () => {
+        const pending = deferred();
+        mocks.getSessions.mockReturnValue(pending.promise);
+        panel = new PlayerStats({ player });
+        await flush();
+        panel.enabled(true);
+        panel.destroy();
+        pending.resolve([session]);
+        await flush();
+        await vi.advanceTimersByTimeAsync(11000);
+        Events.trigger(player, 'timeupdate');
+        await flush();
+        expect(content()).toBeUndefined();
+        expect(mocks.getSessions).toHaveBeenCalledTimes(1);
+        expect(player.getStats).toHaveBeenCalledTimes(1);
+    });
+
+    it('discards late statistics from the previous playback session', async () => {
+        const previous = deferred();
+        mocks.getSessions.mockReturnValueOnce(previous.promise).mockReturnValue(deferred().promise);
+        panel = new PlayerStats({ player });
+        await flush();
+        playbackManager.playSessionId.mockReturnValue('next-play-session');
+        playbackManager.currentMediaSource.mockReturnValue({
+            Id: 'next-source', Container: 'mkv', MediaStreams: [{ Type: 'Video', Codec: 'hevc' }]
+        });
+        Events.trigger(player, 'timeupdate');
+        expect(content()).toContain('HEVC');
+        expect(content()).not.toContain('H264');
+        previous.resolve([session]);
+        await flush();
+        expect(content()).not.toContain('DirectPlaying');
+        expect(mocks.getSessions).toHaveBeenCalledTimes(2);
+    });
+
+    it('does not display a server session that belongs to another item', async () => {
+        mocks.getSessions.mockResolvedValue([{ ...session, NowPlayingItem: { Id: 'other-item' } }]);
+        panel = new PlayerStats({ player });
+        await flush();
+        expect(content()).not.toContain('DirectPlaying');
+        expect(content()).toContain('H264');
+    });
+    it('does not rebuild the DOM when a refresh has identical information', async () => {
+        panel = new PlayerStats({ player });
+        await flush();
+        const changes = vi.fn();
+        const observer = new MutationObserver(changes);
+        observer.observe(document.querySelector('.playerStats-stats'), { childList: true });
+        await vi.advanceTimersByTimeAsync(800);
+        Events.trigger(player, 'timeupdate');
+        await flush();
+        observer.disconnect();
+        expect(changes).not.toHaveBeenCalled();
+    });
+});
