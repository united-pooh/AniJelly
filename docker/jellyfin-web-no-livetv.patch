+    expect(view.querySelector('.osdDurationText').textContent).toBe('100');
+});
+
+it('provides every static page element selected by the video controller', () => {
+    const source = readFileSync(join(directory, 'index.js'), 'utf8');
+    const selectors = [...source.matchAll(/view\.querySelector\('([^']+)'\)/g)].map(match => match[1]);
+
+    expect(selectors.filter(selector => !view.querySelector(selector))).toEqual([]);
+});
