--- /dev/null
+++ b/src/constants/mediaOnly.test.ts
@@ -0,0 +1,47 @@
+import { existsSync, readFileSync, readdirSync } from 'node:fs';
+import { join } from 'node:path';
+import { describe, expect, it } from 'vitest';
+
+import { ASYNC_ADMIN_ROUTES } from 'apps/dashboard/routes/_asyncRoutes';
+import { LEGACY_USER_ROUTES } from 'apps/legacy/routes/legacyRoutes/user';
+import { ASYNC_USER_ROUTES } from 'apps/modern/routes/asyncRoutes/user';
+import { DEFAULT_SECTIONS, HomeSectionType } from './homeSectionType';
+
+describe('media library navigation without Live TV or DVR', () => {
+    it.each([
+        ['dashboard', ASYNC_ADMIN_ROUTES],
+        ['legacy library', LEGACY_USER_ROUTES],
+        ['modern library', ASYNC_USER_ROUTES]
+    ])('does not register Live TV or DVR routes in %s', (_name, routes) => {
+        expect(routes.filter(route => /livetv|recordings/.test(route.path || ''))).toEqual([]);
+    });
+
+    it('removes the dedicated legacy dashboard route registry', () => {
+        expect(existsSync(join(import.meta.dirname, '../apps/dashboard/routes/_legacyRoutes.ts'))).toBe(false);
+        expect(readFileSync(join(import.meta.dirname, '../apps/dashboard/routes/routes.tsx'), 'utf8')).not.toContain('LEGACY_ADMIN_ROUTES');
+    });
+
+    it('keeps only populated controller directories in the production import contexts', () => {
+        const sourceDir = join(import.meta.dirname, '../components/viewManager');
+        const source = readFileSync(join(sourceDir, 'ViewManagerPage.tsx'), 'utf8');
+        const contexts = [...source.matchAll(/import\([^`]*`(\.\.\/[^`]+)\/\$\{/g)];
+
+        expect(contexts.length).toBeGreaterThan(0);
+        for (const [, relativeDir] of contexts) {
+            const entries = readdirSync(join(sourceDir, relativeDir), { recursive: true, withFileTypes: true });
+            expect(entries.some(entry => entry.isFile() && /\.(html|[jt]sx?)$/.test(entry.name))).toBe(true);
+        }
+    });
+
+    it('keeps normal library, player and administrator routes', () => {
+        expect(ASYNC_USER_ROUTES.map(route => route.path)).toEqual(expect.arrayContaining(['home', 'movies', 'tv', 'music', 'search']));
+        expect(LEGACY_USER_ROUTES.map(route => route.path)).toEqual(expect.arrayContaining(['details', 'video', 'queue']));
+        expect(ASYNC_ADMIN_ROUTES.map(route => route.path)).toEqual(expect.arrayContaining(['libraries', 'settings', 'playback/transcoding', 'users']));
+    });
+
+    it('offers only available home sections while keeping resume and next up', () => {
+        expect(Object.values(HomeSectionType)).not.toEqual(expect.arrayContaining(['livetv']));
+        expect(Object.values(HomeSectionType)).not.toEqual(expect.arrayContaining(['activerecordings']));
+        expect(DEFAULT_SECTIONS).toEqual(expect.arrayContaining([HomeSectionType.Resume, HomeSectionType.NextUp, HomeSectionType.LatestMedia]));
+    });
+});
diff --git a/src/constants/mediaPlayback.test.js b/src/constants/mediaPlayback.test.js
new file mode 100644
index 0000000000..f837c80a8c
--- /dev/null
+++ b/src/constants/mediaPlayback.test.js
@@ -0,0 +1,67 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { getItems } from 'utils/jellyfin-apiclient/getItems';
+
+import { translateItemsForPlayback } from 'plugins/syncPlay/core/Helper';
+
+vi.mock('utils/jellyfin-apiclient/getItems', () => ({
+    getItems: vi.fn()
+}));
+
+describe('media library playback queues', () => {
+    const apiClient = {
+        getCurrentUserId: vi.fn(() => 'user'),
+        getCurrentUser: vi.fn(),
+        getEpisodes: vi.fn()
+    };
+
+    beforeEach(() => {
+        vi.clearAllMocks();
+    });
+
+    it('keeps selected movie order without fetching another source', async () => {
+        const items = [{ Id: 'second', Type: 'Movie' }, { Id: 'first', Type: 'Movie' }];
+
+        const queue = await translateItemsForPlayback(apiClient, items, { ids: ['first', 'second'] });
+
+        expect(queue.map(item => item.Id)).toEqual(['first', 'second']);
+        expect(getItems).not.toHaveBeenCalled();
+    });
+
+    it('loads playlist media with chapter and trickplay fields', async () => {
+        const items = [{ Id: 'song', Type: 'Audio' }];
+        vi.mocked(getItems).mockResolvedValue({ Items: items });
+
+        const queue = await translateItemsForPlayback(apiClient, [{ Id: 'playlist', Type: 'Playlist' }], {});
+
+        expect(queue).toEqual(items);
+        expect(getItems).toHaveBeenCalledWith(apiClient, 'user', expect.objectContaining({
+            ParentId: 'playlist',
+            Fields: ['Chapters', 'Trickplay'],
+            ExcludeLocationTypes: 'Virtual'
+        }));
+    });
+
+    it('keeps episode auto play from the selected episode onward', async () => {
+        const items = [1, 2, 3].map(number => ({ Id: String(number), Type: 'Episode', SeriesId: 'series' }));
+        apiClient.getCurrentUser.mockResolvedValue({ Configuration: { EnableNextEpisodeAutoPlay: true } });
+        apiClient.getEpisodes.mockResolvedValue({ Items: items });
+
+        const queue = await translateItemsForPlayback(apiClient, [items[1]], {});
+
+        expect(queue).toEqual(items.slice(1));
+        expect(apiClient.getEpisodes).toHaveBeenCalledWith('series', expect.objectContaining({
+            IsVirtualUnaired: false,
+            IsMissing: false,
+            UserId: 'user'
+        }));
+    });
+
+    it('keeps a single episode when auto play is disabled', async () => {
+        const items = [{ Id: 'episode', Type: 'Episode', SeriesId: 'series' }];
+        apiClient.getCurrentUser.mockResolvedValue({ Configuration: { EnableNextEpisodeAutoPlay: false } });
+
+        await expect(translateItemsForPlayback(apiClient, items, {})).resolves.toEqual(items);
+        expect(apiClient.getEpisodes).not.toHaveBeenCalled();
+    });
+});
